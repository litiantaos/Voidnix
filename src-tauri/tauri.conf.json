{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Voidnix",
  "version": "0.1.0",
  "identifier": "com.litiantao.voidnix",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Voidnix",
        "width": 720,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "screenshot",
        "title": "",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "visible": false
      },
      {
        "label": "ocr",
        "title": "OCR 识别",
        "width": 480,
        "height": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; connect-src 'self' https:; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/voidnix/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {},
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDN0M3NTczNzFEMkI2QzYKUldUR3R0SnhjM1Y4ckE4NmdrR2NpUFBNdkpZSDh4ZWRQZ256bVM4WG8vYzdLZExrTEdRNDg0WVUK",
      "endpoints": [
        "https://github.com/litiantaos/Voidnix/releases/latest/download/latest.json"
      ]
    }
  }
}
