<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Finder Sync extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Let the extension act on URLs passed in from Finder's selection. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

<!--
  IPC with the main app:
  The extension writes command JSON files to
    ~/Library/Application Support/com.litiantao.voidnix/extensions/finder-ext/commands/
  which the (non-sandboxed) main app watches via notify.
  路径须与 extensions/finder-ext/native/mod.rs 的 app_data_dir().join("extensions")
  .join("finder-ext").join("commands") 对齐，否则 Sandbox 下 IPC 写入被拒。
-->
<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
<array>
	<string>/Library/Application Support/com.litiantao.voidnix/extensions/finder-ext/</string>
</array>
</dict>
</plist>
