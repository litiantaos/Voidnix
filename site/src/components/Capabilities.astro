---
import { getDict, type Lang } from '../i18n/translations'

interface Props {
  lang?: Lang
}
const { lang = 'zh' } = Astro.props
const t = getDict(lang)
const capabilities = t.capabilities.items
const sc = t.capabilities.scenes
---

<section class="section capabilities" id="capabilities">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">{t.capabilities.eyebrow}</p>
      <h2 class="section-title">{t.capabilities.title}</h2>
      <p class="section-lead">{t.capabilities.lead}</p>
    </div>

    <div class="rows">
      {
        capabilities.map((c, i) => (
          <article class={`cap reveal ${i % 2 === 1 ? 'is-rev' : ''}`} id={c.id}>
            <div class="cap-text">
              <div class="cap-head">
                <span class="cap-icon"><i class={c.icon} /></span>
                <span class="cap-tag">{c.tag}</span>
              </div>
              <h3 class="cap-title">{c.title}</h3>
              <p class="cap-desc">{c.desc}</p>
              <ul class="cap-bullets">
                {c.bullets.map((b) => (
                  <li><i class="ri-check-line" />{b}</li>
                ))}
              </ul>
            </div>
            <div class="cap-scene">
              {c.id === 'search' && (
                <div class="scene soft-card">
                  <div class="sc-search"><i class="ri-search-line" /><span>void</span></div>
                  <div class="sc-row is-active">
                    <span class="sc-ico accent"><i class="ri-terminal-box-fill" /></span>
                    <span class="sc-m"><b>Voidnix</b><small>/Applications</small></span>
                  </div>
                  <div class="sc-group">{sc.groupFile}</div>
                  <div class="sc-row">
                    <span class="sc-ico folder"><i class="ri-folder-3-line" /></span>
                    <span class="sc-m"><b>Voidnix</b><small>~/Code</small></span>
                  </div>
                  <div class="sc-row">
                    <span class="sc-ico"><i class="ri-file-code-line" /></span>
                    <span class="sc-m"><b>index.ts</b><small>~/Code/Voidnix</small></span>
                  </div>
                </div>
              )}
              {c.id === 'clipboard' && (
                <div class="scene soft-card">
                  <div class="sc-row is-active">
                    <span class="sc-ico"><i class="ri-t-box-line" /></span>
                    <span class="sc-m"><b>const FPS = 30</b><small>VS Code · 14:28</small></span>
                  </div>
                  <div class="sc-row">
                    <span class="sc-ico"><i class="ri-t-box-line" /></span>
                    <span class="sc-m"><b>git rebase -i HEAD~3</b><small>Terminal · 14:25</small></span>
                    <span class="sc-fav"><i class="ri-star-fill" /></span>
                  </div>
                  <div class="sc-row">
                    <span class="sc-ico"><i class="ri-t-box-line" /></span>
                    <span class="sc-m"><b>https://github.com/litiantaos/Voidnix</b><small>Chrome · 13:30</small></span>
                  </div>
                  <div class="sc-row">
                    <span class="sc-ico"><i class="ri-t-box-line" /></span>
                    <span class="sc-m"><b>bun run build</b><small>Terminal · 14:18</small></span>
                  </div>
                </div>
              )}
              {c.id === 'agent' && (
                <div class="scene soft-card">
                  <div class="bubble user">{sc.agentUser}</div>
                  <div class="bubble bot">
                    <div class="tool-step"><i class="ri-terminal-line" /><span>run_command · ls</span></div>
                    <div class="tool-out">{sc.agentToolOut}</div>
                  </div>
                  <div class="bubble user"><i class="ri-arrow-right-s-line" /> {sc.agentAction}</div>
                </div>
              )}
              {c.id === 'screenshot' && (
                <div class="scene scene-shot soft-card">
                  <div class="shot-area">
                    <span class="shot-handle tl" />
                    <span class="shot-handle tr" />
                    <span class="shot-handle bl" />
                    <span class="shot-handle br" />
                    <div class="shot-size">1280 × 720</div>
                  </div>
                  <div class="shot-tools">
                    <span class="stool active"><i class="ri-arrow-right-up-line" /></span>
                    <span class="stool"><i class="ri-shapes-line" /></span>
                    <span class="stool"><i class="ri-font-color" /></span>
                    <span class="stool"><i class="ri-eraser-line" /></span>
                    <span class="stool"><i class="ri-qr-code-line" /></span>
                  </div>
                </div>
              )}
              {c.id === 'window' && (
                <div class="scene scene-win soft-card">
                  <div class="snap-grid">
                    <div class="snap-cell" />
                    <div class="snap-cell active" />
                    <div class="snap-cell" />
                    <div class="snap-cell" />
                    <div class="snap-cell" />
                    <div class="snap-cell" />
                  </div>
                  <div class="snap-label"><i class="ri-drag-move-2-line" /> {sc.snapLabel}</div>
                </div>
              )}
              {c.id === 'terminal' && (
                <div class="scene scene-term soft-card">
                  <div class="term-bar"><span class="tdot r" /><span class="tdot y" /><span class="tdot g" /><b>zsh</b></div>
                  <div class="term-body">
                    <div class="tline"><span class="prompt">❯</span> git commit -m <span class="tstr">"fix"</span> <span class="ghost">--amend --no-edit</span></div>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
    margin-bottom: 72px;
  }
  .head .section-title {
    margin: 16px 0 18px;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 10vw, 120px);
  }

  .cap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }
  .cap.is-rev .cap-text {
    order: 2;
  }

  .cap-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .cap-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--accent-wash);
    color: var(--color-accent);
    font-size: 21px;
    border: 1px solid var(--accent-line-soft);
  }
  .cap-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    padding: 4px 10px;
    border-radius: var(--radius-ctrl);
    background: var(--color-fill-5);
    border: 1px solid var(--color-divider);
  }
  .cap-title {
    font-family: var(--font-sans);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .cap-desc {
    color: var(--color-text-secondary);
    font-size: 15.5px;
    line-height: 1.8;
    margin-bottom: 22px;
  }
  .cap-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .cap-bullets li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--color-text-primary);
  }
  .cap-bullets i {
    color: var(--color-accent);
    font-size: 17px;
  }

  /* ── 场景公共框 ── */
  .scene {
    padding: 18px;
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
    position: relative;
  }
  .cap-scene {
    position: relative;
  }
  .cap-scene::after {
    content: '';
    position: absolute;
    inset: -40px;
    background: radial-gradient(
      circle at 60% 40%,
      rgb(var(--color-accent) / 0.08),
      transparent 70%
    );
    z-index: -1;
    filter: blur(20px);
  }

  .sc-search,
  .sc-row,
  .sc-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sc-search {
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--mock-input-fill);
    border: 1px solid var(--soft-surface-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 10px;
  }
  .sc-row {
    padding: 7px 8px;
    border-radius: 6px;
  }
  .sc-row.is-active {
    background: var(--ui-active-fill);
  }
  .sc-ico {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-size: 14px;
    background: var(--color-fill-5);
    color: var(--color-text-secondary);
  }
  .sc-ico.accent {
    background: var(--color-accent);
    color: #fff;
  }
  .sc-ico.folder {
    color: var(--color-folder);
  }
  .sc-m {
    display: flex;
    flex-direction: column;
  }
  .sc-m b {
    font-size: 13px;
    font-weight: 500;
  }
  .sc-m small {
    font-size: 11px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .sc-row.is-active .sc-m b {
    color: var(--color-accent);
  }
  .sc-fav {
    margin-left: auto;
    color: var(--color-warning);
    font-size: 13px;
  }
  .sc-group {
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--color-text-muted);
    padding: 8px 8px 4px;
    letter-spacing: 0.05em;
  }

  /* agent */
  .bubble {
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 8px;
    max-width: 88%;
  }
  .bubble.user {
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-card-solid));
    border: 1px solid var(--accent-line-soft);
    margin-left: auto;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .bubble.bot {
    background: var(--bubble-bot-fill);
    border: 1px solid var(--color-divider);
  }
  .tool-step {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    margin-bottom: 6px;
  }
  .tool-out {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* screenshot */
  .scene-shot {
    padding: 14px;
  }
  .shot-area {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background: linear-gradient(135deg, rgb(var(--cool) / 0.1), rgb(var(--cool) / 0.04));
    border: 1.5px solid var(--color-accent);
    margin-bottom: 12px;
  }
  .shot-handle {
    position: absolute;
    width: 9px;
    height: 9px;
    background: #fff;
    border: 1.5px solid var(--color-accent);
    border-radius: 2px;
  }
  .shot-handle.tl { top: -5px; left: -5px; }
  .shot-handle.tr { top: -5px; right: -5px; }
  .shot-handle.bl { bottom: -5px; left: -5px; }
  .shot-handle.br { bottom: -5px; right: -5px; }
  .shot-size {
    position: absolute;
    top: 8px;
    left: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--shot-badge-ink);
    background: var(--shot-badge-fill);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .shot-tools {
    display: flex;
    gap: 6px;
  }
  .stool {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    background: var(--color-fill-5);
    color: var(--color-text-secondary);
    font-size: 15px;
  }
  .stool.active {
    background: var(--color-accent);
    color: #fff;
  }

  /* window */
  .scene-win {
    padding: 16px;
  }
  .snap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 6px;
    aspect-ratio: 16 / 9;
    margin-bottom: 12px;
  }
  .snap-cell {
    background: rgb(var(--cool) / 0.06);
    border: 1px dashed var(--color-border);
    border-radius: 6px;
  }
  .snap-cell.active {
    background: rgb(var(--color-accent) / 0.14);
    border: 1.5px solid var(--color-accent);
  }
  .snap-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* terminal */
  .scene-term {
    padding: 0;
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    background: rgb(var(--cool) / 0.06);
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .term-bar b {
    margin-left: 8px;
  }
  .tdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .tdot.r { background: var(--color-danger); }
  .tdot.y { background: var(--color-warning); }
  .tdot.g { background: var(--color-success); }
  .term-body {
    padding: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .tline {
    color: var(--color-text-primary);
  }
  .prompt {
    color: var(--color-accent);
    margin-right: 8px;
  }
  .tstr {
    color: var(--color-success);
  }
  .ghost {
    color: var(--color-text-muted);
    background: rgb(var(--color-accent) / 0.1);
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid var(--accent-line-soft);
  }

  @media (max-width: 760px) {
    .cap {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cap.is-rev .cap-text {
      order: 0;
    }
  }
</style>
