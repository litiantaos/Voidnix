<script>
  // ═══════════════════════════════════════════════
  //  仅执行一次（防止多实例重复绑定）
  // ═══════════════════════════════════════════════
  if (!window.__demoStageInit) {
    window.__demoStageInit = true

    const FPS = 30
    const TOTAL = 840

    const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v))
    const lerp = (a, b, t) => a + (b - a) * t
    const easeOut = (t) => 1 - Math.pow(1 - t, 3)
    const easeInOut = (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2)

    function spring(f, start, stiffness = 120, damping = 18, mass = 0.6) {
      const t = Math.max(0, (f - start) / FPS)
      if (t <= 0) return 0
      const w0 = Math.sqrt(stiffness / mass)
      const z = damping / (2 * Math.sqrt(stiffness * mass))
      const wd = w0 * Math.sqrt(Math.max(0, 1 - z * z))
      return 1 - Math.exp(-z * w0 * t) * Math.cos(wd * t)
    }

    function fadeInOut(f, enter, exit, dur = 15) {
      const ein = clamp((f - enter) / dur, 0, 1)
      const eout = 1 - clamp((f - exit) / dur, 0, 1)
      return ein * eout
    }

    // 场景间隙遮罩：在 [fadeOutStart, fadeInStart] 区间返回 0（启动器隐藏），两侧平滑过渡
    function gapMask(f, fadeOutStart, fadeInStart, fade = 5) {
      if (f < fadeOutStart) return 1
      if (f < fadeOutStart + fade) return 1 - (f - fadeOutStart) / fade
      if (f < fadeInStart) return 0
      if (f < fadeInStart + fade) return (f - fadeInStart) / fade
      return 1
    }

    function typeSlice(f, start, end, text) {
      const p = clamp((f - start) / (end - start), 0, 1)
      return text.substring(0, Math.ceil(p * text.length))
    }

    // 元素引用
    const $ = (id) => document.getElementById(id)
    const fogA = $('fogA'), fogB = $('fogB'), menubar = $('menubar')
    const launcher = $('launcher')
    const sbExtTag = $('sbExtTag'), sbExtIcon = $('sbExtIcon'), sbExtName = $('sbExtName')
    const sbText = $('sbText'), sbCursor = $('sbCursor')
    const panelSearch = $('panelSearch'), panelClipboard = $('panelClipboard'), panelAgent = $('panelAgent')
    const grpSearchApp = $('grpSearchApp'), grpSearchFile = $('grpSearchFile')
    const rowVSCode = $('rowVSCode'), rowXcode = $('rowXcode')
    const rowVoidnix = $('rowVoidnix'), rowCodegen = $('rowCodegen'), rowConfig = $('rowConfig')
    const rowVSCodeTitle = rowVSCode.querySelector('.r-title')
    const clip1 = $('clip1'), clip2 = $('clip2'), clip3 = $('clip3'), clip4 = $('clip4'), clip5 = $('clip5')
    const agentUser1 = $('agentUser1'), agentBot = $('agentBot'), agentTool = $('agentTool'), agentResult = $('agentResult'), agentUser2 = $('agentUser2')
    const shotOverlay = $('shotOverlay'), shotSel = $('shotSel'), shotFlash = $('shotFlash'), shotToolbar = $('shotToolbar')
    const winVscode = $('winVscode'), winTerm = $('winTerm')
    const cursorEl = $('cursor'), snapPanel = $('snapPanel')
    const finderWin = $('finderWin'), finderPanel = $('finderPanel')
    const kbdPop = $('kbdPop'), captionEl = $('caption')
    const outro = $('outro'), wordmark = $('wordmark'), keyHint = $('keyHint')
    const stageEl = $('stage')
    // --cool 基元：运行时读取，与 token 单一源（深浅色同值）
    const COOL_RGB = getComputedStyle(document.documentElement).getPropertyValue('--cool').trim() || '100 120 160'

    // ── 自适应缩放 ──
    function fitStage() {
      const wrap = stageEl.closest('.demo-stage')
      if (!wrap) return
      const w = wrap.clientWidth
      const scale = w / 1280
      stageEl.style.transform = `scale(${scale})`
      wrap.style.height = `${720 * scale}px`
    }
    new ResizeObserver(fitStage).observe(stageEl.closest('.demo-stage'))
    fitStage()

    // ── 提升到模块作用域（避免每帧分配）──
    const SEARCH_ROWS = [[grpSearchApp,118],[rowVSCode,123],[rowXcode,128],[grpSearchFile,133],[rowVoidnix,138],[rowCodegen,143],[rowConfig,148]]
    const CLIP_ROWS = [[clip1,234],[clip2,240],[clip3,246],[clip4,252],[clip5,258]]

    // ── 场景级跳过状态（op=0 且上帧也 0 → DOM 已隐藏，跳过整函数）──
    let _launcherOp = -1, _searchOp = -1, _clipboardOp = -1, _agentOp = -1, _finderOp = -1
    let _screenshotOn = false

    // ── 常量值脏检查状态 ──
    let _menubarOp = -1, _kbdOn = false, _kbdHtml = '', _outroOn = false, _capOp = -1, _sbText = ''

    // ── 场景更新函数 ──
    function updateFog(f) {
      const t = (f / TOTAL) * Math.PI * 2
      fogA.style.transform = `translate(${Math.sin(t) * 3}%, ${Math.cos(t * 0.7) * 2}%) scale(${1 + Math.sin(t) * 0.03})`
      fogA.style.opacity = 0.7 + Math.sin(t * 0.5) * 0.08
      fogB.style.transform = `translate(${-Math.sin(t) * 4}%, ${-Math.cos(t * 0.6) * 3}%) scale(${1 + Math.cos(t) * 0.04})`
      fogB.style.opacity = 0.55 + Math.cos(t * 0.4) * 0.1
    }

    function updateDesktop(f) {
      const op = gapMask(f, 765, 822, 8)
      if (op !== _menubarOp) { menubar.style.opacity = op; _menubarOp = op }
    }

    function updateLauncher(f) {
      const fadeIn = clamp((f - 18) / 30, 0, 1)
      const fadeOut = f > 480 ? 1 - clamp((f - 480) / 12, 0, 1) : 1
      // 场景间隙：启动器短暂消失（kbdPop 弹出 → 重新呼出）
      const gm = gapMask(f, 210, 226) * gapMask(f, 344, 360)
      const op = fadeIn * fadeOut * gm
      if (op === 0 && _launcherOp === 0) return
      _launcherOp = op
      launcher.style.opacity = op
      // 弹簧缩放：首次入场用初始 spring，间隙后重新弹入
      const re = f < 210 ? spring(f, 18, 100, 16)
            : f < 344 ? spring(f, 226, 100, 16)
            : spring(f, 360, 100, 16)
      launcher.style.transform = `translate(-50%, -50%) scale(${0.94 + re * 0.06}) translateY(${(1 - re) * 8}px)`
      launcher.style.filter = fadeIn < 1 ? `blur(${(1 - fadeIn) * 10}px)` : 'none'
    }

    function updateSearchBar(f) {
      const clipMode = f >= 226 && f < 344
      const agentMode = f >= 360 && f < 485
      if (clipMode) {
        sbExtIcon.className = 'sb-ext-icon ri-clipboard-line'; sbExtName.textContent = '剪贴板'
        sbExtTag.style.display = 'inline-flex'; sbExtTag.style.opacity = clamp((f - 226) / 6, 0, 1)
      } else if (agentMode) {
        sbExtIcon.className = 'sb-ext-icon ri-robot-2-line'; sbExtName.textContent = 'Agent'
        sbExtTag.style.display = 'inline-flex'; sbExtTag.style.opacity = clamp((f - 360) / 6, 0, 1)
      } else { sbExtTag.style.display = 'none' }
      let text, color
      if (f < 88) { text = '搜索应用、文件、扩展等'; color = 'var(--color-text-muted)' }
      else if (f >= 88 && f <= 118) { text = typeSlice(f, 88, 118, 'code'); color = 'var(--color-text-primary)' }
      else if (f > 118 && f < 210) { text = 'code'; color = 'var(--color-text-primary)' }
      else if (clipMode) { text = '在 剪贴板 中搜索'; color = 'var(--color-text-muted)' }
      else if (agentMode) { text = '在 Agent 中搜索'; color = 'var(--color-text-muted)' }
      else { text = '搜索应用、文件、扩展等'; color = 'var(--color-text-muted)' }
      if (text !== _sbText) { sbText.textContent = text; sbText.style.color = color; _sbText = text }
      if (f >= 88 && f <= 118) sbCursor.style.opacity = 1
      else if (f > 118 && f < 205) sbCursor.style.opacity = Math.floor(f / 15) % 2 === 0 ? 1 : 0
      else sbCursor.style.opacity = 0
    }

    function updateSearchScene(f) {
      const op = fadeInOut(f, 88, 210, 10)
      if (op === 0 && _searchOp === 0) return
      _searchOp = op
      panelSearch.style.opacity = op; panelSearch.style.transform = `translateY(${(1 - op) * 6}px)`
      for (const [el, enter] of SEARCH_ROWS) {
        const s = spring(f, enter, 100, 16); el.style.opacity = s * op; el.style.transform = `translateY(${(1 - s) * 10}px)`
      }
      const active = clamp((f - 152) / 8, 0, 1)
      rowVSCode.style.background = active > 0.01 ? `rgb(${COOL_RGB} / ${active * 0.11})` : 'transparent'
      rowVSCodeTitle.style.color = active > 0.01 ? 'var(--color-accent)' : 'var(--color-text-primary)'
      rowVSCodeTitle.style.fontWeight = active > 0.5 ? '500' : '400'
    }

    function updateClipboardScene(f) {
      const op = fadeInOut(f, 230, 344, 10)
      if (op === 0 && _clipboardOp === 0) return
      _clipboardOp = op
      panelClipboard.style.opacity = op; panelClipboard.style.transform = `translateY(${(1 - op) * 6}px)`
      for (const [el, enter] of CLIP_ROWS) {
        const s = spring(f, enter, 100, 16); el.style.opacity = s * op; el.style.transform = `translateY(${(1 - s) * 10}px)`
      }
      const active = clamp((f - 264) / 8, 0, 1)
      clip2.style.background = active > 0.01 ? `rgb(${COOL_RGB} / ${active * 0.11})` : 'transparent'
    }

    function updateAgentScene(f) {
      const op = fadeInOut(f, 365, 485, 12)
      if (op === 0 && _agentOp === 0) return
      _agentOp = op
      panelAgent.style.opacity = op; panelAgent.style.transform = `translateY(${(1 - op) * 6}px)`
      const typed = typeSlice(f, 378, 415, '列出 extensions 目录下的 ts 文件')
      const userS = spring(f, 376, 100, 16); agentUser1.style.opacity = userS * op; agentUser1.textContent = typed
      // bot 容器跟随 tool-step 入场，避免提前显示空气泡框
      const toolS = spring(f, 428, 100, 16)
      agentBot.style.opacity = toolS * op
      agentTool.style.opacity = toolS * op
      agentResult.style.opacity = spring(f, 445, 100, 16) * op
      const user2S = spring(f, 460, 100, 16); agentUser2.style.opacity = user2S * op; agentUser2.style.transform = `translateY(${(1 - user2S) * 8}px)`
    }

    function updateScreenshotScene(f) {
      if (f < 488 || f > 595) {
        if (_screenshotOn) { shotOverlay.style.opacity = 0; shotToolbar.style.opacity = 0; _screenshotOn = false }
        return
      }
      if (!_screenshotOn) {
        // 场景入口：清除 snap 残留的 inline 位置让 CSS 接管（仅一次）
        winVscode.style.left = ''; winVscode.style.top = ''; winVscode.style.width = ''; winVscode.style.height = ''
        winTerm.style.left = ''; winTerm.style.top = ''; winTerm.style.width = ''; winTerm.style.height = ''
        _screenshotOn = true
      }
      const overlayIn = clamp((f - 488) / 12, 0, 1)
      const overlayOut = f > 585 ? 1 - clamp((f - 585) / 10, 0, 1) : 1
      const ov = overlayIn * overlayOut
      shotOverlay.style.opacity = ov
      shotSel.style.transform = `scale(${0.85 + spring(f, 495, 130, 16) * 0.15})`
      shotToolbar.style.opacity = clamp((f - 495) / 12, 0, 1) * overlayOut
      winVscode.style.opacity = ov
      winTerm.style.opacity = ov * 0.96
      if (f >= 568 && f <= 576) { const fp = f < 572 ? clamp((f - 568) / 4, 0, 1) : 1 - clamp((f - 572) / 4, 0, 1); shotFlash.style.opacity = fp * 0.7 }
      else shotFlash.style.opacity = 0
    }

    function updateSnapScene(f) {
      if (f < 595) return  // 不干预 screenshot 场景的窗口管理
      const winIn = clamp((f - 598) / 14, 0, 1)
      const winOut = f > 695 ? 1 - clamp((f - 695) / 10, 0, 1) : 1
      const winOp = winIn * winOut
      // 场景退场后（winOp=0 且 f>705）所有值恒定，跳过
      if (winOp === 0 && f > 705) return
      const snapE = easeOut(clamp((f - 672) / 18, 0, 1))
      winVscode.style.opacity = winOp
      winVscode.style.left = lerp(290, 16, snapE) + 'px'; winVscode.style.top = lerp(150, 36, snapE) + 'px'
      winVscode.style.width = lerp(560, 616, snapE) + 'px'; winVscode.style.height = lerp(360, 628, snapE) + 'px'
      // 终端同步 snap 到右半屏（16+616+16gap=648）
      winTerm.style.opacity = winOp * 0.96
      winTerm.style.left = lerp(580, 648, snapE) + 'px'; winTerm.style.top = lerp(200, 36, snapE) + 'px'
      winTerm.style.width = lerp(520, 616, snapE) + 'px'; winTerm.style.height = lerp(300, 628, snapE) + 'px'
      if (f < 618 || f > 695) cursorEl.style.opacity = 0
      else {
        cursorEl.style.opacity = clamp((f - 618) / 8, 0, 1) * (f > 685 ? 1 - clamp((f - 685) / 8, 0, 1) : 1)
        let x, y
        if (f < 642) { const t = easeInOut(clamp((f - 622) / 20, 0, 1)); x = lerp(720, 640, t); y = lerp(430, 10, t) }
        else if (f < 665) { x = 640; y = 10 }
        else if (f < 672) { const t = easeInOut(clamp((f - 665) / 7, 0, 1)); x = 640; y = lerp(10, 54, t) }
        else { x = 640; y = 54 }
        cursorEl.style.transform = `translate(${x}px, ${y}px)`
      }
      if (f < 638 || f > 690) snapPanel.style.opacity = 0
      else { const spIn = easeOut(clamp((f - 638) / 8, 0, 1)); const spOut = f > 682 ? 1 - clamp((f - 682) / 8, 0, 1) : 1; snapPanel.style.opacity = spIn * spOut; snapPanel.style.transform = `translateX(-50%) translateY(${(1 - spIn) * -16}px)` }
    }

    function updateFinderScene(f) {
      const fwIn = clamp((f - 703) / 14, 0, 1)
      const fwOut = f > 762 ? 1 - clamp((f - 762) / 8, 0, 1) : 1
      const op = fwIn * fwOut
      if (op === 0 && _finderOp === 0) return
      _finderOp = op
      finderWin.style.opacity = op; finderWin.style.transform = `translateY(${(1 - fwIn) * 12}px)`
      if (f < 727 || f > 768) finderPanel.style.opacity = 0
      else { const fpIn = easeOut(clamp((f - 727) / 12, 0, 1)); const fpOut = f > 760 ? 1 - clamp((f - 760) / 6, 0, 1) : 1; finderPanel.style.opacity = fpIn * fpOut; finderPanel.style.transform = `scale(${0.95 + fpIn * 0.05})` }
    }

    function kbdPopAt(f, start, opt, main) {
      const lf = f - start
      if (lf < 0 || lf > 20) return false
      const enter = spring(lf, 0, 130, 16)
      const fadeOut = lf > 12 ? 1 - clamp((lf - 12) / 8, 0, 1) : 1
      // innerHTML 仅在内容变化时写（每次弹出首帧），避免每帧重建 DOM 致 reflow 卡顿
      const html = `<span class="kbd-opt">${opt}</span><span class="kbd-main">${main}</span>`
      if (html !== _kbdHtml) { kbdPop.innerHTML = html; _kbdHtml = html }
      kbdPop.style.opacity = fadeOut; kbdPop.style.transform = `translate(-50%, -50%) scale(${0.5 + enter * 0.5})`
      return true
    }

    function updateKbdPop(f) {
      if (kbdPopAt(f, 5, '⌥', 'Space')) { _kbdOn = true; return }
      if (kbdPopAt(f, 212, '⌥', 'C')) { _kbdOn = true; return }
      if (kbdPopAt(f, 346, '⌥', 'A')) { _kbdOn = true; return }
      if (kbdPopAt(f, 478, '⌥', 'S')) { _kbdOn = true; return }
      if (kbdPopAt(f, 712, '⌥', 'F')) { _kbdOn = true; return }
      if (_kbdOn) { kbdPop.style.opacity = 0; _kbdOn = false }
    }

    function updateOutro(f) {
      if (f < 765) { if (_outroOn) { outro.style.opacity = 0; _outroOn = false }; return }
      _outroOn = true
      const fadeOut = f > 820 ? 1 - clamp((f - 820) / 14, 0, 1) : 1
      outro.style.opacity = clamp((f - 767) / 12, 0, 1) * fadeOut
      const ws = spring(f, 768, 100, 16); wordmark.style.opacity = ws * fadeOut; wordmark.style.transform = `scale(${0.9 + ws * 0.1})`
      const ks = clamp((f - 773) / 7, 0, 1); keyHint.style.opacity = ks * fadeOut; keyHint.style.transform = `translateY(${(1 - ks) * 6}px)`
    }

    const CAPTIONS = [
      [10, 82, 'Option+Space 随时呼出'], [90, 210, '全局搜索：应用、文件、扩展'],
      [226, 344, '扩展模式：剪贴板历史'], [360, 485, 'Agent：自然语言驱动工具'],
      [488, 593, '截图标注：全屏选区 + 标注工具'], [600, 697, '窗口管理：鼠标顶部触发分屏'],
      [703, 763, '访达工具：快捷键操作 Finder'],
    ]
    function updateCaption(f) {
      let text = '', start = 0
      for (const [s, e, m] of CAPTIONS) { if (f >= s && f < e) { text = m; start = s; break } }
      const op = text ? clamp((f - start - 3) / 8, 0, 1) : 0
      if (text && captionEl.textContent !== text) captionEl.textContent = text
      if (op !== _capOp) { captionEl.style.opacity = op; _capOp = op }
    }

    function renderFrame(f) {
      updateFog(f); updateDesktop(f); updateLauncher(f); updateSearchBar(f)
      updateSearchScene(f); updateClipboardScene(f); updateAgentScene(f)
      updateScreenshotScene(f); updateSnapScene(f); updateFinderScene(f)
      updateKbdPop(f); updateCaption(f); updateOutro(f)
    }

    // 捕获模式：暴露帧渲染
    window.__renderFrame = async (f) => { renderFrame(f); await new Promise((r) => requestAnimationFrame(r)) }

    // 模式判断
    const params = new URLSearchParams(location.search)
    const isCapture = params.get('capture') === '1'

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (isCapture) {
      // 捕获模式：仅渲染首帧，脚本逐帧调 __renderFrame
      renderFrame(0)
    } else if (reducedMotion) {
      // 减少动效：静态展示搜索结果满载帧，不启动动画循环
      renderFrame(190)
    } else {
      // 播放循环（Space 暂停 / ←→ 逐帧）
      let baseTime = performance.now()
      let paused = false
      let pauseAt = 0
      let frameOverride = -1

      const timeFrame = () => {
        const now = paused ? pauseAt : performance.now()
        return Math.floor(((now - baseTime) / 1000) * FPS) % TOTAL
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault()
          paused = !paused
          if (paused) { pauseAt = performance.now() } else { baseTime += performance.now() - pauseAt; frameOverride = -1 }
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault()
          if (!paused) { paused = true; pauseAt = performance.now() }
          const cur = frameOverride >= 0 ? frameOverride : timeFrame()
          frameOverride = (cur + (e.key === 'ArrowRight' ? 1 : -1) + TOTAL) % TOTAL
        }
      })

      let lastFrame = -1
      function loop() {
        const f = frameOverride >= 0 ? frameOverride : timeFrame()
        // 内容是 30fps，60Hz 屏上相邻两帧往往相同——帧号未变跳过，降常驻 CPU
        if (f !== lastFrame) { renderFrame(f); lastFrame = f }
        requestAnimationFrame(loop)
      }
      loop()
    }
  }
</script>
