---
// 演示动画舞台组件——被 Hero.astro（首页）和 demo.astro（独立预览页）共用
// 1280×720 固定画布，外层自动缩放到容器宽度
// 6 个独立 demo 段，统一节奏（快捷键→窗口出现→交互→关闭），可单段循环 / 连续拼接
//
// 架构：
//   demo-utils.ts   常量 + 数学工具（零 DOM 依赖）
//   demo-scenes.ts  createRenderer($) → { renderFrame, resetStage }
//   demo-player.ts  createPlayer({ renderer, $, controls }) → 播放循环 + 键盘 + UI 控件
//   demo-stage.css  全部舞台样式（.demo-stage 作用域）
//
// props:
//   controls（默认 true）：是否渲染下方控制栏。首页传 false 自动连续播放，预览页默认 true
//   lang（默认 zh）：演示语言，驱动 data-lang 属性 + 静态 HTML 文案
import './demo/demo-stage.css'
import { getDemoText } from '../i18n/demo'
import type { Lang } from '../i18n/translations'

interface Props {
  controls?: boolean
  lang?: Lang
}
const { controls = true, lang = 'zh' } = Astro.props
const T = getDemoText(lang)
---

<div class="demo-stage" data-scale="auto" data-controls={controls ? '1' : '0'} data-lang={lang}>
  <div class="stage-frame" id="stageFrame">
    <div class="stage" id="stage">
      <!-- ══ 桌面舞台（始终在场）══ -->
      <div class="fog" aria-hidden="true">
        <span class="fog-a" id="fogA"></span>
        <span class="fog-b" id="fogB"></span>
      </div>
      <div class="grain" aria-hidden="true"></div>

      <!-- 菜单栏 -->
      <div class="menubar" id="menubar">
        <div class="mb-left">
          <span class="mb-apple"></span>
        </div>
        <div class="mb-right">
          <span class="mb-icon"><i class="ri-search-line"></i></span>
          <span class="mb-time">14:32</span>
        </div>
      </div>

      <!-- ══ 桌面应用窗口（窗口管理 / 截图场景）══ -->
      <div class="app-window win-vscode" id="winVscode">
        <div class="aw-bar">
          <span class="aw-dot r"></span><span class="aw-dot y"></span><span class="aw-dot g"></span>
          <span class="aw-title">main.ts — Voidnix</span>
        </div>
        <div class="aw-content">
          <div class="aw-side">
            <span class="aw-file active">main.ts</span>
            <span class="aw-file">search.ts</span>
            <span class="aw-file">config.ts</span>
          </div>
          <div class="aw-code" id="awCode">
            <div class="aw-code-viewport" id="awCodeViewport">
              <div class="aw-ln w30"></div><div class="aw-ln w60"></div><div class="aw-ln w45"></div>
              <div class="aw-ln w70"></div><div class="aw-ln w25"></div><div class="aw-ln w55"></div>
              <div class="aw-ln w50"></div><div class="aw-ln w65"></div><div class="aw-ln w35"></div>
              <div class="aw-ln w40"></div><div class="aw-ln w60"></div><div class="aw-ln w50"></div>
              <div class="aw-ln w30"></div><div class="aw-ln w65"></div><div class="aw-ln w45"></div>
              <div class="aw-ln w55"></div><div class="aw-ln w35"></div><div class="aw-ln w70"></div>
              <div class="aw-ln w50"></div><div class="aw-ln w60"></div><div class="aw-ln w40"></div>
              <div class="aw-ln w30"></div><div class="aw-ln w55"></div><div class="aw-ln w65"></div>
              <div class="aw-ln w45"></div><div class="aw-ln w70"></div><div class="aw-ln w35"></div>
              <div class="aw-ln w50"></div><div class="aw-ln w60"></div><div class="aw-ln w25"></div>
              <div class="aw-ln w40"></div><div class="aw-ln w65"></div><div class="aw-ln w50"></div>
              <div class="aw-ln w30"></div><div class="aw-ln w55"></div><div class="aw-ln w45"></div>
              <div class="aw-ln w70"></div><div class="aw-ln w60"></div><div class="aw-ln w35"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="app-window win-term" id="winTerm">
        <div class="aw-bar">
          <span class="aw-dot r"></span><span class="aw-dot y"></span><span class="aw-dot g"></span>
          <span class="aw-title">zsh — 80×24</span>
        </div>
        <div class="wt-body">
          <div class="wt-line"><span class="wt-prompt">❯</span> bun run dev</div>
          <div class="wt-line wt-dim">  ready in 320ms</div>
          <div class="wt-line wt-dim">  ➜  Local:   localhost:1420</div>
          <div class="wt-line"><span class="wt-prompt">❯</span><span class="wt-ghost"> git status</span></div>
        </div>
      </div>

      <!-- 编辑器窗口（剪贴板粘贴目标） -->
      <div class="editor-window" id="editorWin">
        <div class="aw-bar">
          <span class="aw-dot r"></span><span class="aw-dot y"></span><span class="aw-dot g"></span>
          <span class="aw-title">notes.txt</span>
        </div>
        <div class="ew-body">
          <div class="ew-line"><span id="ewPasted"></span><span class="ew-cursor" id="ewCursor"></span></div>
        </div>
      </div>

      <!-- 鼠标光标（箭头） -->
      <div class="cursor" id="cursor"></div>
      <!-- 鼠标光标（十字标，截图选区阶段） -->
      <div class="cursor-cross" id="cursorCross"></div>

      <!-- snap 面板 -->
      <div class="snap-panel" id="snapPanel">
        <div class="sp-group"><div class="sp-grid cols-2 rows-2"><span class="sp-z"></span><span class="sp-z"></span><span class="sp-z"></span><span class="sp-z"></span></div></div>
        <div class="sp-group"><div class="sp-grid rows-2"><span class="sp-z"></span><span class="sp-z"></span></div></div>
        <div class="sp-group"><div class="sp-grid cols-2"><span class="sp-z" id="snapTarget"></span><span class="sp-z"></span></div></div>
        <div class="sp-group"><div class="sp-nested"><span class="sp-ring"></span><span class="sp-inset"></span></div></div>
        <div class="sp-group"><div class="sp-grid"><span class="sp-z sp-custom"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7 L2 4 A2 2 0 0 1 4 2 L7 2 M13 2 L16 2 A2 2 0 0 1 18 4 L18 7 M18 13 L18 16 A2 2 0 0 1 16 18 L13 18 M7 18 L4 18 A2 2 0 0 1 2 16 L2 13"/></svg></span></div></div>
      </div>

      <!-- 访达场景：Finder 窗口 -->
      <div class="finder-window" id="finderWin">
        <div class="fw-bar">
          <span class="aw-dot r"></span><span class="aw-dot y"></span><span class="aw-dot g"></span>
          <span class="fw-title">extensions</span>
        </div>
        <div class="fw-body">
          <div class="fw-side">
            <span class="fw-side-item active"><i class="ri-folder-3-line"></i> extensions</span>
            <span class="fw-side-item"><i class="ri-download-2-line"></i> {T.finderSidebar[0]}</span>
            <span class="fw-side-item"><i class="ri-file-list-3-line"></i> {T.finderSidebar[1]}</span>
          </div>
          <div class="fw-list">
            <div class="fw-row sel"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">search</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">clipboard</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">agent</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">screenshot</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">translate</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">proxy</span></div>
            <div class="fw-row"><i class="ri-folder-fill fw-folder"></i><span class="fw-name">window-manager</span></div>
          </div>
        </div>
      </div>

      <!-- 访达操作面板（与启动器同尺寸 720×480） -->
      <div class="finder-panel" id="finderPanel">
        <div class="launcher-shell">
          <div class="chrome-fade-demo" aria-hidden="true"></div>
          <div class="search-bar">
            <div class="search-bar-surface" aria-hidden="true"></div>
            <div class="search-bar-content">
              <div class="ext-tag" style="display:flex">
                <span class="ext-tag-icon ri-folder-open-line"></span>
                <span class="ext-tag-name">{T.finderTag}</span>
              </div>
              <span class="search-field">
                <span class="search-text" style="color:var(--color-text-muted)">{T.finderSearch}</span>
              </span>
            </div>
          </div>
          <div class="content-area">
            <div class="panel" style="opacity:1">
              <div class="result-list">
                <div class="fp-row active">
                  <span class="fp-icon"><i class="ri-file-copy-line"></i></span>
                  <span class="fp-title">{T.finderActions[0]}</span>
                  <span class="fp-key">↵</span>
                </div>
                <div class="fp-row">
                  <span class="fp-icon"><i class="ri-terminal-box-line"></i></span>
                  <span class="fp-title">{T.finderActions[1]}</span>
                </div>
                <div class="fp-row">
                  <span class="fp-icon"><i class="ri-file-add-line"></i></span>
                  <span class="fp-title">{T.finderActions[2]}</span>
                </div>
                <div class="fp-row">
                  <span class="fp-icon"><i class="ri-eye-off-line"></i></span>
                  <span class="fp-title">{T.finderActions[3]}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ══ 启动器窗口（复刻真实应用界面）══ -->
      <div class="launcher" id="launcher">
        <div class="launcher-shell">
          <div class="chrome-fade-demo" aria-hidden="true"></div>

          <!-- 搜索栏 -->
          <div class="search-bar" id="searchBar">
            <div class="search-bar-surface" aria-hidden="true"></div>
            <div class="search-bar-content">
              <div class="ext-tag" id="extTag">
                <span class="ext-tag-icon" id="extTagIcon"></span>
                <span class="ext-tag-name" id="extTagName"></span>
              </div>
              <span class="search-field">
                <span class="search-text" id="searchText"></span>
                <span class="search-cursor" id="searchCursor"></span>
              </span>
            </div>
          </div>

          <!-- 内容区 -->
          <div class="content-area">
            <!-- 搜索结果面板 -->
            <div class="panel" id="panelSearch">
              <div class="result-list">
                <div class="group-header" id="grpApp">{T.grpApp}</div>
                <div class="result-item" id="rowVSCode">
                  <div class="result-item-inner">
                    <div class="result-icon icon-app"><i class="ri-code-s-slash-line"></i></div>
                    <div class="result-text">
                      <div class="result-title" id="titleVSCode">VS Code</div>
                      <div class="result-sub">/Applications</div>
                    </div>
                    <div class="result-key">↵</div>
                  </div>
                </div>
                <div class="result-item" id="rowXcode">
                  <div class="result-item-inner">
                    <div class="result-icon"><i class="ri-hammer-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">Xcode</div>
                      <div class="result-sub">/Applications</div>
                    </div>
                  </div>
                </div>
                <div class="group-header" id="grpFile">{T.grpFile}</div>
                <div class="result-item" id="rowVoidnix">
                  <div class="result-item-inner">
                    <div class="result-icon icon-folder"><i class="ri-folder-3-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">voidnix</div>
                      <div class="result-sub">~/Code/Voidnix</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="rowCodegen">
                  <div class="result-item-inner">
                    <div class="result-icon icon-file"><i class="ri-file-code-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">codegen.ts</div>
                      <div class="result-sub">~/Code/Voidnix/scripts</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="rowConfig">
                  <div class="result-item-inner">
                    <div class="result-icon icon-file"><i class="ri-file-text-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">config.json</div>
                      <div class="result-sub">~/Code/Voidnix/src-tauri</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 剪贴板面板 -->
            <div class="panel" id="panelClipboard">
              <div class="result-list">
                <div class="result-item" id="clip1">
                  <div class="result-item-inner">
                    <div class="result-icon icon-text"><i class="ri-t-box-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">const FPS = 30</div>
                      <div class="result-sub">VS Code · 14:28</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="clip2">
                  <div class="result-item-inner">
                    <div class="result-icon icon-text"><i class="ri-t-box-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">git rebase -i HEAD~3</div>
                      <div class="result-sub">Terminal · 14:25</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="clip3">
                  <div class="result-item-inner">
                    <div class="result-icon icon-text"><i class="ri-t-box-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">bun run build</div>
                      <div class="result-sub">Terminal · 14:18</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="clip4">
                  <div class="result-item-inner">
                    <div class="result-icon icon-text"><i class="ri-t-box-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">https://github.com/litiantaos/Voidnix</div>
                      <div class="result-sub">Chrome · 13:30</div>
                    </div>
                  </div>
                </div>
                <div class="result-item" id="clip5">
                  <div class="result-item-inner">
                    <div class="result-icon icon-text"><i class="ri-t-box-line"></i></div>
                    <div class="result-text">
                      <div class="result-title">npm install -D @types/node</div>
                      <div class="result-sub">VS Code · 11:45</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- OCR 结果面板 -->
            <div class="panel" id="panelOcr">
              <div class="ocr-view">
                <div class="ocr-preview" id="ocrPreview">
                  <div class="ocr-preview-skel"></div>
                </div>
                <div class="ocr-text-area" id="ocrTextArea"></div>
                <div class="group-header">{T.grpOps}</div>
                <div class="result-item" id="ocrAction">
                  <div class="result-item-inner">
                    <div class="result-icon"><i class="ri-file-copy-line"></i></div>
                    <div class="result-text"><div class="result-title">{T.ocrAction}</div></div>
                    <div class="result-key">↵</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Agent 面板 -->
            <div class="panel" id="panelAgent">
              <div class="agent-messages" id="agentMessages">
                <div class="agent-row user" id="agentUserRow">
                  <div class="agent-bubble user" id="agentUserBubble"></div>
                </div>
                <div class="agent-row assistant" id="agentAsstRow">
                  <div class="agent-card" id="agentCard">
                    <div class="agent-step" id="agentTool">
                      <span class="agent-step-head">
                        <span class="agent-step-icon i-ri-terminal-line"></span>
                        <span class="agent-step-label">run_command</span>
                        <span class="agent-step-detail">find extensions -name "*.ts"</span>
                      </span>
                      <div class="agent-step-body" id="agentResult">
                        <span class="agent-step-gutter"><span class="agent-step-rail"></span></span>
                        <pre class="agent-step-out">{T.agentToolOut}</pre>
                      </div>
                    </div>
                    <div class="agent-text" id="agentText"></div>
                  </div>
                </div>
              </div>
              <div class="agent-footer" id="agentFooter">
                <div class="agent-input-shell">
                  <span class="agent-input-text">{T.agentInputPlaceholder}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 截图场景：全屏 overlay -->
      <div class="shot-overlay" id="shotOverlay">
        <div class="shot-sel" id="shotSel">
          <span class="shot-handle tl"></span><span class="shot-handle tr"></span><span class="shot-handle bl"></span><span class="shot-handle br"></span>
          <span class="shot-size">960 × 480</span>
          <div class="shot-flash" id="shotFlash"></div>
          <!-- 标注方框（演示画矩形标注） -->
          <div class="shot-rect" id="shotRect"></div>
        </div>
        <!-- 放大窗（选区阶段光标跟随） -->
        <div class="shot-mag" id="shotMag">
          <canvas class="shot-mag-canvas" id="shotMagCanvas" width="180" height="180"></canvas>
          <div class="shot-mag-cross-h"></div>
          <div class="shot-mag-cross-v"></div>
        </div>
        <div class="shot-toolbar" id="shotToolbar">
          <span class="shot-tool" id="shotRectBtn" title={T.shotTools.rect}><i class="ri-checkbox-blank-line"></i></span>
          <span class="shot-tool" title={T.shotTools.line}><i class="ri-subtract-line"></i></span>
          <span class="shot-tool" title={T.shotTools.arrow}><i class="ri-arrow-right-line"></i></span>
          <span class="shot-tool" title={T.shotTools.text}><i class="ri-text"></i></span>
          <span class="shot-tool" title={T.shotTools.blur}><i class="ri-drop-line"></i></span>
          <span class="shot-sep"></span>
          <span class="shot-color-dot"></span>
          <span class="shot-sep"></span>
          <span class="shot-tool" id="shotOcrBtn" title={T.shotTools.ocr}><i class="ri-qr-scan-2-line"></i></span>
          <span class="shot-tool" id="shotScrollBtn" title={T.shotTools.scroll}><i class="ri-arrow-down-double-line"></i></span>
          <span class="shot-tool" title={T.shotTools.pin}><i class="ri-pushpin-line"></i></span>
          <span class="shot-tool" title={T.shotTools.save}><i class="ri-save-line"></i></span>
          <span class="shot-sep"></span>
          <span class="shot-tool" title={T.shotTools.close}><i class="ri-close-line"></i></span>
          <span class="shot-tool" title={T.shotTools.copy}><i class="ri-check-line"></i></span>
        </div>
        <!-- 滚动截屏：右侧实时预览面板 -->
        <div class="shot-scroll-preview" id="shotScrollPreview">
          <div class="ssp-content" id="sspContent">
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
            <div class="ssp-line w80"></div><div class="ssp-line w55"></div><div class="ssp-line w70"></div>
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
            <div class="ssp-line w80"></div><div class="ssp-line w55"></div><div class="ssp-line w70"></div>
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
            <div class="ssp-line w80"></div><div class="ssp-line w55"></div><div class="ssp-line w70"></div>
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
            <div class="ssp-line w80"></div><div class="ssp-line w55"></div><div class="ssp-line w70"></div>
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
            <div class="ssp-line w80"></div><div class="ssp-line w55"></div><div class="ssp-line w70"></div>
            <div class="ssp-line w85"></div><div class="ssp-line w60"></div><div class="ssp-line w75"></div>
            <div class="ssp-line w50"></div><div class="ssp-line w90"></div><div class="ssp-line w65"></div>
          </div>
        </div>
      </div>

      <!-- 操作反馈 toast -->
      <div class="demo-toast" id="demoToast"><i class="ri-check-line"></i> {T.toastPasted}</div>

      <!-- 快捷键键帽 -->
      <div class="kbd-pop" id="kbdPop"></div>
      <!-- 场景字幕 -->
      <div class="caption" id="caption"></div>
    </div>
  </div>

  <!-- 控制栏（在缩放画布下方，不缩放；首页不渲染） -->
  {controls && (
    <div class="demo-controls" id="demoControls">
    <div class="seg-btns" id="segBtns">
      {T.segBtns.map((label, i) => (
        <button class={`seg-btn ${i === 0 ? 'active' : ''}`} data-i={i}>{label}</button>
      ))}
    </div>
    <span class="ctrl-sep"></span>
    <button class="seg-btn all-btn" id="allBtn">{T.btnPlayAll}</button>
    <button class="icon-btn" id="playBtn" aria-label={T.playAria}><i class="ri-pause-fill"></i></button>
    <div class="prog-track" id="progTrack"><div class="prog-fill" id="progFill"></div></div>
  </div>
  )}
</div>

<script>
  import { createRenderer } from './demo/demo-scenes'
  import { createPlayer } from './demo/demo-player'

  if (!window.__demoStageInit) {
    window.__demoStageInit = true
    const $ = (id) => document.getElementById(id)
    const stage = document.querySelector('.demo-stage')!
    const controls = stage.dataset.controls !== '0'
    const renderer = createRenderer($)
    createPlayer({ renderer, $, controls })
  }
</script>
