---
import Wordmark from './Wordmark.astro'

const GITHUB = 'https://github.com/litiantaos/Voidnix'
const RELEASES = GITHUB + '/releases/latest'
---

<section class="hero" id="top">
  <!-- Mica 雾团：复刻产品 mica-shell 两团缓慢漂移的冷蓝光晕 -->
  <div class="fog" aria-hidden="true">
    <span class="fog-a"></span>
    <span class="fog-b"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <header class="nav container">
    <Wordmark size={26} />
  </header>

  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow reveal">macOS 效率启动器</p>
      <h1 class="hero-title display reveal">想到就到，触手可及</h1>

      <div class="hero-chips reveal">
        <span class="chip"><i class="ri-stack-line"></i> 模块化</span>
        <span class="chip"><i class="ri-flashlight-line"></i> 原生性能</span>
        <span class="chip"><i class="ri-leaf-line"></i> 极简</span>
      </div>

      <div class="hero-cta reveal">
        <a id="download-btn" href={RELEASES} class="btn btn-primary" target="_blank" rel="noopener">
          <i class="ri-download-2-line"></i> 下载
        </a>
        <a href={GITHUB} class="btn btn-ghost" target="_blank" rel="noopener">
          <i class="ri-github-fill"></i> GitHub
        </a>
      </div>

      <p class="hero-cta-meta reveal">Apple Silicon · macOS 13+</p>
    </div>

    <!-- 产品 mockup：纯 CSS 复刻启动器窗口（搜索栏 + 分组结果） -->
    <div class="mock-wrap reveal">
      <div class="launcher soft-card">
        <div class="search-bar">
          <i class="ri-search-line sb-icon"></i>
          <span class="sb-text">Option+Space</span>
          <span class="sb-kbd">⌥ Space</span>
        </div>
        <div class="group-label">应用</div>
        <div class="row is-active">
          <span class="row-icon accent-bg"><i class="ri-terminal-box-fill"></i></span>
          <span class="row-main">
            <span class="row-title">终端</span>
            <span class="row-sub">/System/Applications</span>
          </span>
          <span class="row-key">↵</span>
        </div>
        <div class="row">
          <span class="row-icon"><i class="ri-code-s-slash-line"></i></span>
          <span class="row-main">
            <span class="row-title">VS Code</span>
            <span class="row-sub">/Applications</span>
          </span>
        </div>
        <div class="group-label">文件</div>
        <div class="row">
          <span class="row-icon folder"><i class="ri-folder-3-line"></i></span>
          <span class="row-main">
            <span class="row-title">voidnix</span>
            <span class="row-sub">~/Code/Voidnix</span>
          </span>
        </div>
        <div class="row">
          <span class="row-icon file"><i class="ri-file-code-line"></i></span>
          <span class="row-main">
            <span class="row-title">index.ts</span>
            <span class="row-sub">~/Code/Voidnix/extensions/search</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // 直链最新 release 的 dmg（版本无关），失败回退 releases 页
  const btn = document.getElementById('download-btn')
  if (btn) {
    fetch('https://api.github.com/repos/litiantaos/Voidnix/releases/latest')
      .then((r) => r.json())
      .then((data) => {
        const assets = data.assets ?? []
        const dmg =
          assets.find((a) => /aarch64\.dmg$/.test(a.name)) ??
          assets.find((a) => /\.dmg$/.test(a.name))
        if (dmg?.browser_download_url) {
          btn.href = dmg.browser_download_url
          btn.removeAttribute('target')
        }
      })
      .catch(() => {})
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 80px;
  }

  /* ── Mica 雾团 ── */
  .fog {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* blur() 会让子元素像素外扩，isolation + clip 兜底确保裁住 */
    isolation: isolate;
    clip-path: inset(0);
  }
  .fog-a,
  .fog-b {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform, opacity;
  }
  .fog-a {
    width: 60%;
    height: 48%;
    left: -6%;
    top: -10%;
    background: var(--mica-fog-a);
    animation: fog-a 24s var(--ease-out) infinite;
  }
  .fog-b {
    width: 52%;
    height: 44%;
    right: -8%;
    bottom: -12%;
    background: var(--mica-fog-b);
    animation: fog-b 28s var(--ease-out) infinite;
  }
  @keyframes fog-a {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate(5%, 6%) scale(1.06); opacity: 0.85; }
  }
  @keyframes fog-b {
    0%, 100% { transform: translate(0, 0) scale(1.02); opacity: 0.55; }
    50% { transform: translate(-5%, -5%) scale(0.96); opacity: 0.72; }
  }

  /* 极淡颗粒，消除大面积平涂的廉价感 */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 50% 0%,
      rgb(var(--cool) / 0.05),
      transparent 60%
    );
  }

  .nav,
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  /* ── 导航 ── */
  .nav {
    padding-top: 28px;
  }

  /* ── 主体 ── */
  .hero-inner {
    flex: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
    padding-top: clamp(40px, 8vh, 96px);
  }

  .hero-copy {
    max-width: 560px;
    padding-top: 44px;
  }

  .hero-title {
    font-size: clamp(34px, 4.5vw, 52px);
    margin: 36px 0 0;
    color: var(--color-text-primary);
  }

  .hero-sub {
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--color-text-secondary);
    max-width: 52ch;
    line-height: 1.7;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 44px 0 92px;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
  }
  .hero-cta-meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  /* ── Mockup ── */
  .mock-wrap {
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }
  .launcher {
    width: 100%;
    max-width: 440px;
    padding: 14px;
    border-radius: var(--radius-window);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-text-primary) 5%, transparent),
      0 24px 60px rgb(var(--shadow-ink) / 0.18),
      0 8px 24px rgb(var(--shadow-ink) / 0.1);
    transform: rotateY(-6deg) rotateX(2deg);
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .launcher:hover {
    transform: rotateY(-3deg) rotateX(1deg) translateY(-2px);
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-panel);
    background: var(--mock-input-fill);
    border: 1px solid var(--soft-surface-border);
    backdrop-filter: blur(20px);
    margin-bottom: 8px;
  }
  .sb-icon {
    color: var(--color-text-muted);
    font-size: 18px;
  }
  .sb-text {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 14px;
    flex: 1;
  }
  .sb-kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--color-fill-8);
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    padding: 10px 8px 6px;
    letter-spacing: 0.05em;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: var(--radius-ctrl);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .row.is-active {
    background: var(--ui-active-fill);
  }
  .row-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-size: 16px;
    color: var(--color-text-secondary);
    background: var(--color-fill-5);
    flex-shrink: 0;
  }
  .row-icon.accent-bg {
    background: var(--color-accent);
    color: #fff;
  }
  .row-icon.folder {
    color: var(--color-folder);
  }
  .row-icon.file {
    color: var(--color-file);
  }
  .row-main {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }
  .row-title {
    font-size: 14px;
    color: var(--color-text-primary);
  }
  .row-sub {
    font-size: 12px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row.is-active .row-title {
    color: var(--color-accent);
    font-weight: 500;
  }
  .row-key {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    padding: 2px 7px;
    border-radius: 4px;
    background: rgb(var(--color-accent) / 0.12);
  }

  @media (max-width: 880px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-copy {
      max-width: none;
    }
    .mock-wrap {
      order: 2;
    }
    .launcher {
      transform: none;
    }
    .launcher:hover {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 480px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
