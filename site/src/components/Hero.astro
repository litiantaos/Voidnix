---
import Wordmark from './Wordmark.astro'
import DemoStage from './DemoStage.astro'
import { getDict, type Lang } from '../i18n/translations'

interface Props {
  lang?: Lang
}
const { lang = 'zh' } = Astro.props
const t = getDict(lang)

const GITHUB = 'https://github.com/litiantaos/Voidnix'
const RELEASES = GITHUB + '/releases/latest'
---

<section class="hero" id="top">
  <!-- Mica 雾团：复刻产品 mica-shell 两团缓慢漂移的冷蓝光晕 -->
  <div class="fog" aria-hidden="true">
    <span class="fog-a"></span>
    <span class="fog-b"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <header class="nav container">
    <Wordmark size={26} />
    <div class="nav-actions">
      <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label={t.layout.themeAuto}
        title={t.layout.themeAuto}
        data-labels={JSON.stringify({
          auto: t.layout.themeAuto,
          light: t.layout.themeLight,
          dark: t.layout.themeDark,
        })}
      >
        <i class="ri-computer-line" data-icon="auto"></i>
        <i class="ri-sun-line" data-icon="light"></i>
        <i class="ri-moon-line" data-icon="dark"></i>
      </button>
      <a href={t.layout.langHref} class="lang-toggle" aria-label="Language">
        {t.layout.langLabel}
      </a>
    </div>
  </header>

  <div class="hero-inner container">
    <div class="hero-copy">
      <h1 class="hero-title display reveal">{lang === 'en' ? `${t.hero.titleLead} ` : t.hero.titleLead}<span class="title-accent">{t.hero.titleAccent}</span></h1>

      <p class="hero-slogan reveal">{t.hero.slogan}</p>

      <div class="hero-cta reveal">
        <a id="download-btn" href={RELEASES} class="btn btn-primary" target="_blank" rel="noopener">
          <i class="ri-download-2-line"></i> {t.hero.download}
        </a>
        <a href={GITHUB} class="btn btn-ghost" target="_blank" rel="noopener">
          <i class="ri-github-fill"></i> GitHub
        </a>
      </div>

      <p class="hero-cta-meta reveal">{t.hero.meta}</p>
    </div>

  </div>

  <!-- 产品演示：实时动画舞台 -->
  <div class="demo-section reveal">
    <DemoStage lang={lang} />
  </div>
</section>

<script>
  // 直链最新 release 的 dmg（版本无关），失败回退 releases 页
  const btn = document.getElementById('download-btn')
  if (btn) {
    fetch('https://api.github.com/repos/litiantaos/Voidnix/releases/latest')
      .then((r) => r.json())
      .then((data) => {
        const assets = data.assets ?? []
        const dmg =
          assets.find((a) => /aarch64\.dmg$/.test(a.name)) ??
          assets.find((a) => /\.dmg$/.test(a.name))
        if (dmg?.browser_download_url) {
          btn.href = dmg.browser_download_url
          btn.removeAttribute('target')
        }
      })
      .catch(() => {})
  }

  // 主题三态切换：auto（跟随系统）→ light → dark 循环，与 ThemeInit 共用存储键
  const themeBtn = document.getElementById('themeToggle') as HTMLButtonElement | null
  if (themeBtn) {
    const labels = JSON.parse(themeBtn.dataset.labels ?? '{}') as Record<string, string>
    const mq = matchMedia('(prefers-color-scheme: dark)')
    const NEXT: Record<string, 'auto' | 'light' | 'dark'> = {
      auto: 'light',
      light: 'dark',
      dark: 'auto',
    }
    type Pref = 'auto' | 'light' | 'dark'
    const pref = (): Pref => {
      try {
        return (localStorage.getItem('voidnix-site-theme') as Pref) || 'auto'
      } catch {
        return 'auto'
      }
    }
    const apply = (p: Pref) => {
      try {
        localStorage.setItem('voidnix-site-theme', p)
      } catch {}
      const dark = p === 'dark' || (p !== 'light' && mq.matches)
      document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      const meta = document.querySelector('meta[name="theme-color"]')
      if (meta) meta.content = dark ? '#1c1c1e' : '#f8f8f9'
      themeBtn.dataset.state = p
      const label = labels[p] ?? p
      themeBtn.title = label
      themeBtn.setAttribute('aria-label', label)
    }
    themeBtn.dataset.state = pref()
    themeBtn.addEventListener('click', () => apply(NEXT[pref()] ?? 'auto'))
    // auto 态下系统外观切换即时跟随
    mq.addEventListener('change', () => {
      if (pref() === 'auto') apply('auto')
    })
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 80px;
  }

  /* ── Mica 雾团 ── */
  .fog {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* blur() 会让子元素像素外扩，isolation + clip 兜底确保裁住 */
    isolation: isolate;
    clip-path: inset(0);
  }
  .fog-a,
  .fog-b {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform, opacity;
  }
  .fog-a {
    width: 60%;
    height: 48%;
    left: -6%;
    top: -10%;
    background: var(--mica-fog-a);
    animation: fog-a 24s var(--ease-out) infinite;
  }
  .fog-b {
    width: 52%;
    height: 44%;
    right: -8%;
    bottom: -12%;
    background: var(--mica-fog-b);
    animation: fog-b 28s var(--ease-out) infinite;
  }
  @keyframes fog-a {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate(5%, 6%) scale(1.06); opacity: 0.85; }
  }
  @keyframes fog-b {
    0%, 100% { transform: translate(0, 0) scale(1.02); opacity: 0.55; }
    50% { transform: translate(-5%, -5%) scale(0.96); opacity: 0.72; }
  }

  /* 极淡颗粒，消除大面积平涂的廉价感 */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 50% 0%,
      rgb(var(--cool) / 0.05),
      transparent 60%
    );
  }

  .nav {
    position: relative;
    z-index: 1;
    padding-top: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* 语言切换 + 主题切换 */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang-toggle,
  .theme-toggle {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 6px 14px;
    border-radius: var(--radius-ctrl);
    border: 1px solid var(--soft-chip-border);
    background: var(--soft-chip-fill);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .lang-toggle:hover,
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--accent-line);
  }
  .theme-toggle {
    width: 34px;
    height: 31px;
    padding: 0;
    display: grid;
    place-items: center;
    font-size: 15px;
    cursor: pointer;
  }
  /* 三态图标随当前偏好切换显示 */
  .theme-toggle i {
    display: none;
    line-height: 1;
  }
  .theme-toggle[data-state='auto'] i[data-icon='auto'],
  .theme-toggle[data-state='light'] i[data-icon='light'],
  .theme-toggle[data-state='dark'] i[data-icon='dark'] {
    display: block;
  }

  /* ── 主体 ── */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(40px, 8vh, 96px);
  }

  .hero-copy {
    max-width: 580px;
  }

  .hero-title {
    font-size: clamp(38px, 5.5vw, 60px);
    margin: 0;
    color: var(--color-text-primary);
  }
  /* 标题后半渐变着色，accent 提亮视觉重心 */
  .title-accent {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-slogan {
    font-size: clamp(15px, 1.4vw, 17px);
    color: var(--color-text-secondary);
    max-width: 48ch;
    line-height: 1.7;
    margin: 24px 0 32px;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .hero-cta-meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  /* reveal 错峰入场（title → slogan → cta → meta） */
  .hero-copy > .reveal:nth-child(1) { transition-delay: 0ms; }
  .hero-copy > .reveal:nth-child(2) { transition-delay: 80ms; }
  .hero-copy > .reveal:nth-child(3) { transition-delay: 160ms; }
  .hero-copy > .reveal:nth-child(4) { transition-delay: 240ms; }

  /* ── Demo 舞台 ── */
  /* demo-section 与 .container 共用同一套横向盒模型（width / max-width / padding-inline），
     保证 demo 可视框与上方正文在任意视口宽度严格对齐 */
  .demo-section {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    margin-top: 48px;
    padding-inline: var(--content-pad);
  }

  @media (max-width: 880px) {
    .demo-section {
      margin-top: 32px;
    }
  }

  @media (max-width: 480px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
