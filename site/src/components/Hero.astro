---
import Wordmark from './Wordmark.astro'
import DemoStage from './DemoStage.astro'

const GITHUB = 'https://github.com/litiantaos/Voidnix'
const RELEASES = GITHUB + '/releases/latest'
---

<section class="hero" id="top">
  <!-- Mica 雾团：复刻产品 mica-shell 两团缓慢漂移的冷蓝光晕 -->
  <div class="fog" aria-hidden="true">
    <span class="fog-a"></span>
    <span class="fog-b"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <header class="nav container">
    <Wordmark size={26} />
  </header>

  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow reveal"><span class="eyebrow-dot"></span>macOS 效率启动器</p>
      <h1 class="hero-title display reveal">想到就到，<span class="title-accent">触手可及</span></h1>

      <div class="hero-chips reveal">
        <span class="chip"><i class="ri-stack-line"></i> 模块化</span>
        <span class="chip"><i class="ri-flashlight-line"></i> 原生性能</span>
        <span class="chip"><i class="ri-leaf-line"></i> 极简</span>
      </div>

      <div class="hero-cta reveal">
        <a id="download-btn" href={RELEASES} class="btn btn-primary" target="_blank" rel="noopener">
          <i class="ri-download-2-line"></i> 下载
        </a>
        <a href={GITHUB} class="btn btn-ghost" target="_blank" rel="noopener">
          <i class="ri-github-fill"></i> GitHub
        </a>
      </div>

      <p class="hero-cta-meta reveal">Apple Silicon · macOS 13+</p>
    </div>

  </div>

  <!-- 产品演示：实时动画舞台 -->
  <div class="demo-section reveal">
    <DemoStage controls={false} />
  </div>
</section>

<script>
  // 直链最新 release 的 dmg（版本无关），失败回退 releases 页
  const btn = document.getElementById('download-btn')
  if (btn) {
    fetch('https://api.github.com/repos/litiantaos/Voidnix/releases/latest')
      .then((r) => r.json())
      .then((data) => {
        const assets = data.assets ?? []
        const dmg =
          assets.find((a) => /aarch64\.dmg$/.test(a.name)) ??
          assets.find((a) => /\.dmg$/.test(a.name))
        if (dmg?.browser_download_url) {
          btn.href = dmg.browser_download_url
          btn.removeAttribute('target')
        }
      })
      .catch(() => {})
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 80px;
  }

  /* ── Mica 雾团 ── */
  .fog {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* blur() 会让子元素像素外扩，isolation + clip 兜底确保裁住 */
    isolation: isolate;
    clip-path: inset(0);
  }
  .fog-a,
  .fog-b {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform, opacity;
  }
  .fog-a {
    width: 60%;
    height: 48%;
    left: -6%;
    top: -10%;
    background: var(--mica-fog-a);
    animation: fog-a 24s var(--ease-out) infinite;
  }
  .fog-b {
    width: 52%;
    height: 44%;
    right: -8%;
    bottom: -12%;
    background: var(--mica-fog-b);
    animation: fog-b 28s var(--ease-out) infinite;
  }
  @keyframes fog-a {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate(5%, 6%) scale(1.06); opacity: 0.85; }
  }
  @keyframes fog-b {
    0%, 100% { transform: translate(0, 0) scale(1.02); opacity: 0.55; }
    50% { transform: translate(-5%, -5%) scale(0.96); opacity: 0.72; }
  }

  /* 极淡颗粒，消除大面积平涂的廉价感 */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 50% 0%,
      rgb(var(--cool) / 0.05),
      transparent 60%
    );
  }

  .nav {
    position: relative;
    z-index: 1;
    padding-top: 28px;
  }

  /* ── 主体 ── */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(40px, 8vh, 96px);
  }

  .hero-copy {
    max-width: 580px;
  }

  /* eyebrow 视觉锚点：accent 实心圆点 */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .hero-title {
    font-size: clamp(38px, 5.5vw, 60px);
    margin: 28px 0 0;
    color: var(--color-text-primary);
  }
  /* 标题后半渐变着色，accent 提亮视觉重心 */
  .title-accent {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    font-size: clamp(15px, 1.4vw, 17px);
    color: var(--color-text-secondary);
    max-width: 52ch;
    line-height: 1.7;
    margin-top: 18px;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 28px 0 32px;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .hero-cta-meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  /* reveal 错峰入场（eyebrow → title → sub → chips → cta → meta） */
  .hero-copy > .reveal:nth-child(1) { transition-delay: 0ms; }
  .hero-copy > .reveal:nth-child(2) { transition-delay: 70ms; }
  .hero-copy > .reveal:nth-child(3) { transition-delay: 140ms; }
  .hero-copy > .reveal:nth-child(4) { transition-delay: 210ms; }
  .hero-copy > .reveal:nth-child(5) { transition-delay: 280ms; }
  .hero-copy > .reveal:nth-child(6) { transition-delay: 350ms; }

  /* ── Demo 舞台 ── */
  /* demo-section 与 .container 共用同一套横向盒模型（width / max-width / padding-inline），
     保证 demo 可视框与上方正文在任意视口宽度严格对齐 */
  .demo-section {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    margin-top: 48px;
    padding-inline: var(--content-pad);
  }

  @media (max-width: 880px) {
    .demo-section {
      margin-top: 32px;
    }
  }

  @media (max-width: 480px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
