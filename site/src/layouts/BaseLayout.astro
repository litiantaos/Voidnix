---
import '../styles/tokens.css'
import '../styles/global.css'
import { getDict, type Lang } from '../i18n/translations'

interface Props {
  lang?: Lang
  isDemo?: boolean
}
const { lang = 'zh', isDemo = false } = Astro.props
const t = getDict(lang)

const title = isDemo ? t.layout.demoTitle : t.layout.title
const description = t.layout.description
const site = Astro.site ?? new URL('https://voidnix.litiantao.com')
const og = new URL('/og-image.png', site)
---

<!doctype html>
<html lang={t.layout.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f8f9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1c1e" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.href} />
    <meta property="og:url" content={site.href} />
    <meta property="og:locale" content={t.layout.ogLocale} />
    {lang === 'en' && <meta property="og:locale:alternate" content="zh_CN" />}
    {lang === 'zh' && <meta property="og:locale:alternate" content="en_US" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />

    <!-- hreflang 双语互指 -->
    <link rel="alternate" hreflang="zh-CN" href={new URL('/', site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site).href} />

    <!-- Remix Icon（与产品图标集一致） -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
    />
  </head>
  <body>
    <slot />

    <!-- 滚动渐入：极简 observer，错峰由 transition-delay 控制 -->
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible')
              io.unobserve(e.target)
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      )
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
