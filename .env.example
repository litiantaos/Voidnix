# Tauri updater 签名密钥（生产构建由 CI secrets 注入，本地开发可留空）
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS 代码签名身份（稳定 TCC 授权，避免每次重新打包后系统权限失效）
# 查看：security find-identity -v -p codesigning
# CI 发布需在 GitHub secrets 配置同名变量：
#   APPLE_CERTIFICATE（.p12 base64）/ APPLE_CERTIFICATE_PASSWORD / APPLE_SIGNING_IDENTITY
APPLE_SIGNING_IDENTITY=
