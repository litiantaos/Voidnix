{
  "name": "voidnix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri:dev": "bun run sync:extensions && bun run lint && tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev": "vite",
    "build": "bun run sync:extensions && bun run lint && vue-tsc --noEmit && vite build",
    "lint": "prettier --write . && eslint . --fix",
    "sync:extensions": "bun run scripts/sync-extensions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.7",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.1",
    "@unocss/eslint-plugin": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "@wdio/cli": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "@wdio/spec-reporter": "^9.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.10.2",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unocss": "^66.7.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3",
    "webdriverio": "^9.28.0"
  }
