{
  "name": "voidnix",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check:drift && bun run lint && bun run typecheck && vite build",
    "tauri:dev": "bun run build:zsh-bin && bun run sync:extensions && bun run check:drift && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:zsh-bin": "cargo build --manifest-path extensions/zsh-autosuggestions/native/Cargo.toml",
    "prebuild:zsh": "CARGO_TARGET_DIR=$PWD/src-tauri/target cargo build --release --manifest-path extensions/zsh-autosuggestions/native/Cargo.toml",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "typecheck": "vue-tsc --noEmit",
    "sync:extensions": "bun run scripts/sync-extensions.ts",
    "check:drift": "bun run check:extensions && bun run check:commands && bun run check:agent-bounds && bun run check:wm-bounds && bun run check:extension-orders",
    "check:extensions": "bun run scripts/sync-extensions.ts -- --check",
    "check:commands": "bun run scripts/check-commands.ts",
    "check:agent-bounds": "bun run scripts/check-agent-bounds.ts",
    "check:wm-bounds": "bun run scripts/check-wm-bounds.ts",
    "check:extension-orders": "bun run scripts/check-extension-orders.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "precheck": "bun run lint:check && cargo fmt --manifest-path src-tauri/Cargo.toml --check && bun run typecheck && cargo clippy --manifest-path src-tauri/Cargo.toml --lib -- -D warnings && bun run check:drift && bun run test && cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "pinia": "^4.0.2",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@unocss/eslint-plugin": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
