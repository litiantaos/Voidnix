{
  "name": "voidnix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri:dev": "cargo build --manifest-path src-tauri/Cargo.toml --bin zsh-autosuggestions && bun run sync:extensions && bun run check:commands && bun run check:agent-bounds && bun run lint && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:zsh-bin": "cargo build --manifest-path src-tauri/Cargo.toml --bin zsh-autosuggestions",
    "prebuild:zsh": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin zsh-autosuggestions",
    "dev": "vite",
    "build": "bun run check:extensions && bun run check:commands && bun run check:agent-bounds && bun run lint && vue-tsc --noEmit && vite build",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "sync:extensions": "bun run scripts/sync-extensions.ts",
    "check:extensions": "bun run scripts/sync-extensions.ts -- --check",
    "check:commands": "bun run scripts/check-commands.ts",
    "check:agent-bounds": "bun run scripts/check-agent-bounds.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.3",
    "@unocss/eslint-plugin": "^66.7.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  }
}
