{
  "name": "voidnix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:extensions && vite",
    "build": "bun run sync:extensions && vue-tsc --noEmit && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "sync:extensions": "bun run scripts/sync-extensions.ts",
    "check:extensions": "bun run scripts/sync-extensions.ts --check",
    "gen:bindings": "bun run sync:extensions && cd src-tauri && cargo test --features specta export_bindings -- --nocapture",
    "tauri:debug-app": "tauri build --debug && bash scripts/embed.sh debug && open src-tauri/target/debug/bundle/macos/Voidnix.app",
    "tauri:release-app": "tauri build && bash scripts/embed.sh release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^14.3.0",
    "dompurify": "^3.4.7",
    "marked": "^18.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "@unocss/eslint-plugin": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "typescript": "~6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  }
}
